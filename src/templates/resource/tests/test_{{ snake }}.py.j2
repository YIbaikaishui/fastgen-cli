def test_module_registered() -> None:
    assert modules["{{ snake }}"] == "{{ source }}.modules.{{ snake }}"


def test_router_prefix() -> None:
    assert router.prefix == "/{{ plural }}"


async def test_create_read_update_delete(client: AsyncClient) -> None:
    created = await client.post("/{{ plural }}", json=_payload())
    assert created.status_code == 201
    body = created.json()
    assert isinstance(body["id"], int)
    assert set(_payload()) <= set(body)

    fetched = await client.get(f"/{{ plural }}/{body['id']}")
    assert fetched.status_code == 200
    assert fetched.json()["id"] == body["id"]

    patched = await client.patch(f"/{{ plural }}/{body['id']}", json=_payload())
    assert patched.status_code == 200
    assert patched.json()["id"] == body["id"]

    deleted = await client.delete(f"/{{ plural }}/{body['id']}")
    assert deleted.status_code == 204

    gone = await client.get(f"/{{ plural }}/{body['id']}")
    assert gone.status_code == 404


async def test_list_is_paginated(client: AsyncClient) -> None:
    for _ in range(2):
        assert (await client.post("/{{ plural }}", json=_payload())).status_code == 201

    page = await client.get("/{{ plural }}", params={"limit": 1, "offset": 0})
    assert page.status_code == 200
    body = page.json()
    assert body["total"] == 2
    assert body["limit"] == 1
    assert body["offset"] == 0
    assert len(body["items"]) == 1

    second = await client.get("/{{ plural }}", params={"limit": 1, "offset": 1})
    assert second.status_code == 200
    assert second.json()["items"][0]["id"] != body["items"][0]["id"]

    # `limit` is bounded, so an absurd page size is a 422 rather than a full scan.
    assert (await client.get("/{{ plural }}", params={"limit": 1000})).status_code == 422


async def test_missing_resource_is_404(client: AsyncClient) -> None:
    assert (await client.get("/{{ plural }}/424242")).status_code == 404
    assert (await client.delete("/{{ plural }}/424242")).status_code == 404


async def test_payload_is_validated(client: AsyncClient) -> None:
    unknown = await client.patch("/{{ plural }}/1", json={"nope": 1})
    assert unknown.status_code == 422, "unknown fields must be rejected"

